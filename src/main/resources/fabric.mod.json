{
    "schemaVersion": 1,
    "id": "ewconnect",
    "version": "${version}",
    "name": "EwConnect",
    "description": "Mod for the ew smp",
    "authors": [
        "SynesthesiaDev"
    ],
    "contact": {},
    "license": "MIT",
    "icon": "assets/ewconnect/icon.png",
    "environment": "server",
    "entrypoints": {
        "main": [
            "dev.synesthesia.ewconnect.EwConnect"
        ]
    },
    "mixins": [
        "ewconnect.mixins.json"
